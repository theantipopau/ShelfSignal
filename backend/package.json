{
  "name": "shelfsignal-backend",
  "version": "1.0.0",
  "description": "ShelfSignal API — barcode-first price signals for Australian households",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/migrations/run.js up",
    "migrate:seed": "node src/migrations/run.js up seed",
    "test": "jest --runInBand",
    "lint": "eslint src/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.1"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
