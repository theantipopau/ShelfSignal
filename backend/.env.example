# ShelfSignal API environment
# Copy to .env for local development.

NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://shelfsignal:shelfsignal@localhost:5432/shelfsignal
DATABASE_POOL_SIZE=10

# JWT — always set a strong secret outside development
JWT_SECRET=change-me-in-any-shared-environment
JWT_EXPIRES_IN=7d

# Signal engine tuning (defaults shown)
MINIMUM_PUSH_MATCH_CONFIDENCE=0.75
DEFAULT_COOLDOWN_HOURS=24
BASELINE_WINDOW=30
FRESHNESS_HOURS=48
